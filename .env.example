TIKTOK_USERNAME=
WS_PORT=
HTTP_PORT=
EASYDONATE_API_KEY=
TTS_ENGINE_URL=

# Song requests. Required -- without a key the feature stays off rather than
# running unvalidated. Needs YouTube Data API v3 enabled on the project.
YOUTUBE_API_KEY=
# Region checked against a video's regionRestriction before it can be queued.
YOUTUBE_REGION=TH
# Requests longer than this are refused (seconds).
SONG_MAX_DURATION_SEC=600

# YouTube live chat, mixed into the same chat overlay as TikTok. Optional --
# leave both empty to keep it off. No API key needed (public streams only).
# Channel handle (@name), channel ID (UC...) or channel URL; the server follows
# whatever it is streaming right now and waits until it goes live.
YOUTUBE_CHANNEL=
# Read this video's chat instead (overrides YOUTUBE_CHANNEL) -- needed for
# unlisted streams, which don't show up on the channel's /live page.
YOUTUBE_VIDEO_ID=

# Local testing without a live. MOCK=1: fake follow alerts instead of connecting
# to TikTok (and Gift history goes to logs/mock-gifts/). MOCK_CHAT=1 on top of
# that adds fake chat, gifts, joins, stickers and song requests.
MOCK=0
MOCK_CHAT=0
